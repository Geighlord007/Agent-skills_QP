# OS junk
.DS_Store
Thumbs.db
desktop.ini

# WSL/Windows metadata
*:Zone.Identifier
*.Zone.Identifier

# Editor backups
*~
*.swp
*.swo
.vscode/
.idea/

# Python bytecode (auto-generated)
**/__pycache__/
*.pyc
*.pyo

# Node/Bun dependencies (regenerate locally)
**/node_modules/
**/bun.lock

# Local config
.env
.env.local

# Third-party tools cloned locally at the repo ROOT, not versioned here.
# Anchored with a leading slash on purpose: an unanchored "tools/" also swallowed the
# tools/ directories INSIDE skills (e.g. cosmetic-research/tools, nice-baogao/tools),
# which silently kept real skill code out of the repository.
/tools/
